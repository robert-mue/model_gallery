 "metadata": {
  "title": "Acclimation capacity of coral reefs to a warming ocean",
  "description": "A trait-based model of a coral community (Coral, cm2), its symbiotic algae (Symbiont, cells) and the energy corals invest in the symbiosis (Trait), which moves up the gradient of coral fitness at the speed of acclimation N. Forced by monthly sea-surface temperature 1955-2100 after a 2000-year spin-up; symbionts are expelled (bleaching) when the temperature exceeds the optimum for coral growth by a regional threshold. Time is in months; time 0 is January 1955. Opens with the Great Barrier Reef under RCP 4.5; the other regions and scenarios are parameter files.",
  "keywords": [
   "coral",
   "bleaching",
   "acclimation",
   "climate change",
   "trait-based"
  ],
  "paper": {
   "citation": "Raharinirina NA, Acevedo-Trejos E, Merico A (2022) Modelling the acclimation capacity of coral reefs to a warming ocean. PLoS Comput Biol 18(5): e1010099.",
   "url": "https://doi.org/10.1371/journal.pcbi.1010099"
  },
  "page": "https://robert-mue.github.io/model_gallery/models/coral/"
 },
