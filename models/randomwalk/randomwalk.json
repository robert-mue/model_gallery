 "metadata": {
  "title": "Random walk of a small population",
  "description": "Demographic stochasticity: each year every animal survives with probability 0.8, and each survivor produces a surviving daughter with probability 0.25 (a daughter, 0.5, that survives, 0.5), so the expected growth is zero. The population wanders at random until it dies out. Run it several times. (The program stopped at 0 or above 100; here the run is 100 years.) Converted from the TrueBASIC program RANDOMWALK.TRU on the CD of the book.",
  "keywords": [
   "population",
   "stochastic",
   "demographic stochasticity",
   "extinction",
   "random walk"
  ],
  "page": "https://robert-mue.github.io/model_gallery/models/randomwalk/",
  "paper": {
   "citation": "Owen-Smith N (2007) Introduction to Modeling in Wildlife and Resource Conservation. Blackwell Publishing, Oxford. ISBN 978-1-4051-4439-1.",
   "url": "https://gov.wiley.com/WileyCDA/WileyTitle/productCd-1405144394.html"
  }
 },
