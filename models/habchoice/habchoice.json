 "metadata": {
  "title": "Habitat choice through the dormant season",
  "description": "Herbivores feed through 26 weeks of the dormant season in three habitats offering the same food but different energy yields (0.8, 0.65, 0.5), with no regrowth. They either spread across the habitats in proportion to the gains each offers (matching: maximizing = 0) or all feed where the gain is highest (maximizing = 1). Time is in weeks; food in g/m2. Converted from the TrueBASIC program HABCHOICE.TRU on the CD of the book.",
  "keywords": [
   "habitat choice",
   "foraging",
   "herbivore",
   "ideal free distribution",
   "functional response"
  ],
  "page": "https://robert-mue.github.io/model_gallery/models/habchoice/",
  "paper": {
   "citation": "Owen-Smith N (2007) Introduction to Modeling in Wildlife and Resource Conservation. Blackwell Publishing, Oxford. ISBN 978-1-4051-4439-1.",
   "url": "https://gov.wiley.com/WileyCDA/WileyTitle/productCd-1405144394.html"
  }
 },
