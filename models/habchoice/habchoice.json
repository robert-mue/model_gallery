 "enums": {},
 "nodes": {
  "node1": {
   "type": "stock",
   "parent": "submodel1",
   "label": "Food",
   "props": {
    "initial": "start_food",
    "units": ""
   }
  },
  "node2": {
   "type": "variable",
   "parent": "submodel1",
   "label": "energy",
   "props": {
    "value": "element([0.8, 0.65, 0.5], index(1))",
    "units": ""
   }
  },
  "node3": {
   "type": "variable",
   "parent": "submodel1",
   "label": "intake",
   "props": {
    "value": "max_intake*Food/(half_saturation + Food)",
    "units": ""
   }
  },
  "node4": {
   "type": "variable",
   "parent": "submodel1",
   "label": "gain",
   "props": {
    "value": "intake*energy",
    "units": ""
   }
  },
  "node5": {
   "type": "variable",
   "parent": "submodel1",
   "label": "share",
   "props": {
    "value": "if maximizing > 0.5 then (if gain >= best_gain then 1.0 else 0.0) else gain/total_gain",
    "units": ""
   }
  },
  "node6": {
   "type": "valve",
   "parent": "submodel1",
   "label": "eaten",
   "props": {
    "rate": "intake*consumers*body_mass*share",
    "units": ""
   }
  },
  "node7": {
   "type": "cloud",
   "parent": "submodel1",
   "label": "",
   "props": {}
  },
  "node8": {
   "type": "variable",
   "parent": "submodel1",
   "label": "gain_obtained",
   "props": {
    "value": "gain*share",
    "units": ""
   }
  },
  "node9": {
   "type": "variable",
   "parent": null,
   "label": "total_gain",
   "props": {
    "value": "sum([gain])",
    "units": ""
   }
  },
  "node10": {
   "type": "variable",
   "parent": null,
   "label": "best_gain",
   "props": {
    "value": "greatest([gain])",
    "units": ""
   }
  },
  "node11": {
   "type": "variable",
   "parent": null,
   "label": "mean_gain",
   "props": {
    "value": "sum([gain_obtained])",
    "units": ""
   }
  },
  "node12": {
   "type": "variable",
   "parent": null,
