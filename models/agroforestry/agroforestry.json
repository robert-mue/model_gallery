   }
  },
  "node4": {
   "type": "variable",
   "parent": null,
   "label": "crown_lai",
   "props": {
    "paramKind": "variable",
    "value": "3",
    "min": "0",
    "max": "6",
    "units": ""
   }
  },
  "node5": {
   "type": "variable",
   "parent": null,
   "label": "extinction_k",
   "props": {
    "value": "0.5",
    "units": ""
   }
  },
  "node6": {
   "type": "variable",
   "parent": null,
   "label": "growth_rate",
   "props": {
    "value": "1.5",
    "units": ""
   }
  },
  "node7": {
   "type": "variable",
   "parent": null,
   "label": "max_height",
   "props": {
    "value": "20",
    "units": ""
   }
  },
  "node8": {
   "type": "variable",
   "parent": null,
   "label": "pasture_growth_rate",
   "props": {
    "value": "2",
    "units": ""
   }
  },
  "node9": {
   "type": "variable",
   "parent": null,
   "label": "pasture_capacity",
   "props": {
    "value": "4",
    "units": ""
   }
  },
  "node10": {
   "type": "variable",
   "parent": "submodel1",
   "label": "col",
   "props": {
    "value": "fmod(index(1)-1,40)",
    "units": ""
   }
  },
  "node11": {
   "type": "variable",
   "parent": "submodel1",
   "label": "row",
   "props": {
    "value": "floor((index(1)-1)/40)",
    "units": ""
   }
  },
  "node12": {
   "type": "variable",
   "parent": "submodel1",
   "label": "px",
   "props": {
    "value": "2.5*col+1.25",
    "units": ""
   }
  },
  "node13": {
   "type": "variable",
   "parent": "submodel1",
   "label": "py",
   "props": {
    "value": "2.5*row+1.25",
    "units": ""
   }
  },
  "node14": {
   "type": "stock",
   "parent": "submodel1",
   "label": "Pasture",
   "props": {
    "initial": "pasture_capacity",
    "units": ""
   }
  },
  "node15": {
   "type": "cloud",
   "parent": "submodel1",
   "label": "",
   "props": {}
  },
  "node16": {
   "type": "cloud",
   "parent": "submodel1",
   "label": "",
   "props": {}
  },
  "node17": {
   "type": "variable",
   "parent": "submodel1",
   "label": "light",
   "props": {
    "value": "exp(-extinction_k*sum({cover_ground}))",
    "units": ""
   }
  },
  "node18": {
   "type": "valve",
   "parent": "submodel1",
   "label": "pasture_growth",
   "props": {
    "rate": "pasture_growth_rate*light*Pasture*(1-Pasture/pasture_capacity)",
    "units": ""
   }
  },
  "node19": {
   "type": "valve",
   "parent": "submodel1",
   "label": "grazing",
   "props": {
    "rate": "grazing_rate*Pasture",
    "units": ""
   }
  },
  "node20": {
   "type": "initialiser",
   "parent": "submodel2",
   "label": "initial_trees",
   "props": {
    "expr": "20"
   }
  },
  "node21": {
   "type": "migrator",
   "parent": "submodel2",
   "label": "planting",
   "props": {
    "expr": "planting_rate"
   }
  },
  "node22": {
   "type": "exterminator",
   "parent": "submodel2",
   "label": "felling",
   "props": {
    "expr": "Height>harvest_height"
   }
  },
  "node23": {
   "type": "stock",
   "parent": "submodel2",
   "label": "Height",
   "props": {
    "initial": "1",
    "units": ""
   }
  },
  "node24": {
   "type": "cloud",
   "parent": "submodel2",
   "label": "",
   "props": {}
  },
  "node25": {
   "type": "valve",
   "parent": "submodel2",
   "label": "height_growth",
   "props": {
    "rate": "growth_rate*(1-Height/max_height)",
    "units": ""
   }
  },
  "node26": {
   "type": "variable",
   "parent": "submodel2",
   "label": "x",
   "props": {
    "value": "rand_const(0,100)",
    "units": ""
   }
  },
  "node27": {
   "type": "variable",
   "parent": "submodel2",
   "label": "y",
   "props": {
    "value": "rand_const(0,100)",
    "units": ""
   }
  },
  "node28": {
   "type": "variable",
   "parent": "submodel2",
   "label": "crown_radius",
   "props": {
    "value": "0.3*Height",
    "units": ""
   }
  },
  "node29": {
   "type": "variable",
   "parent": "submodel2",
   "label": "volume",
   "props": {
    "value": "0.0004*Height^3",
    "units": ""
   }
  },
  "node30": {
   "type": "condition",
   "parent": "submodel3",
   "label": "overhead",
   "props": {
    "expr": "hypot(px_ground-x_crown,py_ground-y_crown)<crown_radius_crown"
   }
  },
  "node31": {
   "type": "variable",
   "parent": "submodel3",
   "label": "cover",
   "props": {
    "value": "crown_lai*(1-(hypot(px_ground-x_crown,py_ground-y_crown)/crown_radius_crown)^2)",
    "units": ""
   }
  },
  "node32": {
   "type": "variable",
   "parent": null,
   "label": "mean_pasture",
   "props": {
    "value": "sum([Pasture])/1600",
    "units": ""
   }
  },
  "node33": {
   "type": "variable",
   "parent": null,
   "label": "number_of_trees",
   "props": {
    "value": "count({Height})",
    "units": ""
   }
  },
  "node34": {
   "type": "variable",
   "parent": null,
   "label": "standing_timber",
   "props": {
    "value": "sum({volume})",
    "units": ""
   }
  }
 },
