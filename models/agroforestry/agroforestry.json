 "metadata": {
  "title": "Trees over pasture",
  "description": "A silvopastoral field, 100 m square: individual trees, planted and felled, grow over a pasture of 1600 patches 2.5 m square. Each patch gets the light that passes the tree crowns directly above it (a vertical sun), by Beer's law; a crown intercepts most at its centre, its leaf area falling to nothing at its edge. Shaded pasture grows more slowly, and under deep shade gives way to grazing. Time is in years, heights and distances in metres, pasture in tonnes per hectare, timber in cubic metres.",
  "keywords": [
   "agroforestry",
   "silvopasture",
   "individual-based",
   "spatial",
   "shading",
   "association"
  ],
  "page": "https://robert-mue.github.io/model_gallery/models/agroforestry/"
 },
