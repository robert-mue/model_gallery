 "metadata": {
  "title": "Herbivore-vegetation dynamics (Caughley)",
  "description": "Caughley's (1976) model of an interactive herbivore-vegetation system, with a hyperbolic functional response: vegetation (kg/ha) grows logistically after being grazed, herbivores (kg/ha) gain from what they eat and lose to metabolism. The two oscillate towards an equilibrium; herbivores die out if the vegetation cannot sustain them. Converted from the TrueBASIC program HVCAUGHLEY.tru on the CD of the book.",
  "keywords": [
   "herbivore",
   "vegetation",
   "consumer-resource",
   "Caughley",
   "functional response"
  ],
  "page": "https://robert-mue.github.io/model_gallery/models/hvcaughley/",
  "paper": {
   "citation": "Owen-Smith N (2007) Introduction to Modeling in Wildlife and Resource Conservation. Blackwell Publishing, Oxford. ISBN 978-1-4051-4439-1.",
   "url": "https://gov.wiley.com/WileyCDA/WileyTitle/productCd-1405144394.html"
  }
 },
