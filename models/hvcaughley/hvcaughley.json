 "id": "hvcaughley",
 "name": "Herbivore-vegetation dynamics",
 "enums": {},
 "nodes": {
  "node1": {
   "type": "stock",
   "parent": null,
   "label": "Vegetation",
   "props": {
    "initial": "3000",
    "units": ""
   }
  },
  "node2": {
   "type": "stock",
   "parent": null,
   "label": "Herbivores",
   "props": {
    "initial": "50",
    "units": ""
   }
  },
  "node3": {
   "type": "variable",
   "parent": null,
   "label": "intake",
   "props": {
    "value": "max(0, max_intake*(Vegetation - ungrazeable)/(half_saturation + (Vegetation - ungrazeable)))",
    "units": ""
   }
  },
  "node4": {
   "type": "variable",
   "parent": null,
   "label": "eaten",
   "props": {
    "value": "min(intake*Herbivores, Vegetation)",
    "units": ""
   }
  },
  "node5": {
   "type": "variable",
   "parent": null,
   "label": "residual",
   "props": {
    "value": "Vegetation - eaten",
    "units": ""
   }
  },
  "node6": {
   "type": "valve",
   "parent": null,
   "label": "regrowth",
   "props": {
    "rate": "residual*veg_growth_rate*(1 - residual/veg_max)",
    "units": ""
   }
  },
  "node7": {
   "type": "cloud",
   "parent": null,
   "label": "",
   "props": {}
  },
  "node8": {
   "type": "valve",
   "parent": null,
   "label": "grazing",
   "props": {
    "rate": "eaten",
    "units": ""
   }
  },
  "node9": {
   "type": "cloud",
   "parent": null,
   "label": "",
   "props": {}
  },
  "node10": {
   "type": "valve",
   "parent": null,
   "label": "gain",
   "props": {
    "rate": "Herbivores*intake*conversion",
    "units": ""
   }
  },
  "node11": {
   "type": "cloud",
   "parent": null,
   "label": "",
   "props": {}
  },
  "node12": {
   "type": "valve",
   "parent": null,
   "label": "metabolism",
   "props": {
    "rate": "min(Herbivores*metabolic_loss, Herbivores + gain)",
    "units": ""
   }
  },
  "node13": {
   "type": "cloud",
   "parent": null,
   "label": "",
   "props": {}
  },
  "node14": {
   "type": "variable",
   "parent": null,
   "label": "veg_max",
   "props": {
    "paramKind": "variable",
    "value": "3000",
    "min": "500",
    "max": "6000",
    "units": ""
   }
  },
  "node15": {
   "type": "variable",
   "parent": null,
   "label": "veg_growth_rate",
   "props": {
    "paramKind": "variable",
    "value": "0.8",
    "min": "0",
    "max": "2",
    "units": ""
   }
  },
  "node16": {
   "type": "variable",
   "parent": null,
   "label": "ungrazeable",
   "props": {
    "paramKind": "variable",
    "value": "10",
    "min": "0",
    "max": "500",
    "units": ""
   }
  },
  "node17": {
   "type": "variable",
   "parent": null,
   "label": "max_intake",
   "props": {
    "paramKind": "variable",
    "value": "1.2",
    "min": "0",
    "max": "3",
    "units": ""
   }
  },
  "node18": {
   "type": "variable",
   "parent": null,
   "label": "half_saturation",
   "props": {
    "paramKind": "variable",
    "value": "800",
    "min": "50",
    "max": "3000",
    "units": ""
   }
  },
  "node19": {
   "type": "variable",
   "parent": null,
   "label": "conversion",
   "props": {
    "paramKind": "variable",
    "value": "1.25",
    "min": "0",
    "max": "3",
    "units": ""
   }
  },
  "node20": {
   "type": "variable",
   "parent": null,
   "label": "metabolic_loss",
   "props": {
    "paramKind": "variable",
    "value": "1.1",
    "min": "0",
    "max": "2",
    "units": ""
   }
  }
 },
