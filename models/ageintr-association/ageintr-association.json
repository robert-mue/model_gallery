 "id": "ageintr_association",
 "name": "Age classes: a next-class association",
 "enums": {},
 "nodes": {
  "node1": {
   "type": "stock",
   "parent": "submodel1",
   "label": "n",
   "props": {
    "initial": "element([40, 20, 16, 14, 10], index(1))",
    "units": ""
   }
  },
  "node2": {
   "type": "variable",
   "parent": "submodel1",
   "label": "class_no",
   "props": {
    "value": "index(1)",
    "units": ""
   }
  },
  "node3": {
   "type": "variable",
   "parent": "submodel1",
   "label": "S",
   "props": {
    "value": "element([0.6, 0.85, 0.9, 0.9, 0.0], index(1))",
    "units": ""
   }
  },
  "node4": {
   "type": "variable",
   "parent": "submodel1",
   "label": "B",
   "props": {
    "value": "element([0.0, 0.0, 0.7, 0.85, 0.85], index(1))",
    "units": ""
   }
  },
  "node5": {
   "type": "valve",
   "parent": "submodel1",
   "label": "ageing_in",
   "props": {
    "rate": "if index(1) == 1 then births else sum({transfer_older})",
    "units": ""
   }
  },
  "node6": {
   "type": "cloud",
   "parent": "submodel1",
   "label": "",
   "props": {}
  },
  "node7": {
   "type": "valve",
   "parent": "submodel1",
   "label": "ageing_out",
   "props": {
    "rate": "S*n",
    "units": ""
   }
  },
  "node8": {
   "type": "cloud",
   "parent": "submodel1",
   "label": "",
   "props": {}
  },
  "node9": {
   "type": "valve",
   "parent": "submodel1",
   "label": "death",
   "props": {
    "rate": "(1-S)*n",
    "units": ""
   }
  },
  "node10": {
   "type": "cloud",
   "parent": "submodel1",
   "label": "",
   "props": {}
  },
  "node11": {
   "type": "variable",
   "parent": "submodel1",
   "label": "fec",
   "props": {
    "value": "B*sum({transfer_older})",
    "units": ""
   }
  },
  "node12": {
   "type": "condition",
   "parent": "submodel2",
   "label": "is_next",
   "props": {
    "expr": "class_no_older == class_no_younger + 1"
   }
  },
  "node13": {
   "type": "variable",
   "parent": "submodel2",
   "label": "transfer",
   "props": {
    "value": "ageing_out_younger",
    "units": ""
   }
  },
  "node14": {
   "type": "variable",
   "parent": null,
   "label": "births",
   "props": {
    "value": "sum([fec])",
    "units": ""
   }
  },
  "node15": {
   "type": "variable",
   "parent": null,
   "label": "total",
   "props": {
    "value": "sum([n])",
    "units": ""
   }
  }
 },
