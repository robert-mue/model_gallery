 "metadata": {
  "title": "Age-structured population: submodel and \"next class\" association",
  "description": "Five age classes, newborns being class 0. Each year the animals in each class survive into the next, or die (none survive beyond class 4), and the survivors reaching classes 2 to 4 give birth. This version: as the submodel, but each class receives only from the class below, through an association; the diagram shows the relationship. In \"next_class\", one instance for each pair of classes where the older's number is one more than the younger's, \"transfer\" passes the younger's ageing_out to the older. Survival from ages 0-3: [0.6, 0.85, 0.9, 0.9]; births per animal reaching ages 2-4: [0.7, 0.85, 0.85]; starting numbers [40, 20, 16, 14, 10] (chosen for illustration: the program asks for them). Converted from the TrueBASIC program AGEINTR.tru on the CD of the book.",
  "keywords": [
   "population",
   "age structure",
   "Simile design",
   "teaching"
  ],
  "page": "https://robert-mue.github.io/model_gallery/models/ageintr-association/",
  "paper": {
   "citation": "Owen-Smith N (2007) Introduction to Modeling in Wildlife and Resource Conservation. Blackwell Publishing, Oxford. ISBN 978-1-4051-4439-1.",
   "url": "https://gov.wiley.com/WileyCDA/WileyTitle/productCd-1405144394.html"
  },
  "family": {
   "title": "An age-structured population: four designs in Simile",
   "members": [
    {
     "model": "ageintr-stocks",
     "title": "A stock per age class",
     "summary": "conventional System Dynamics: five stocks, ageing flows between them; easy to follow, but every class repeats the same equations",
     "file": "../ageintr-stocks/ageintr-stocks.json"
    },
    {
     "model": "ageintr-array",
     "title": "One submodel, five instances",
     "summary": "the class written once, in a fixed-membership submodel; ageing passed between instances through an array every instance sees",
     "file": "../ageintr-array/ageintr-array.json"
    },
    {
     "model": "ageintr-association",
     "title": "Submodel and \"next class\" association",
     "summary": "as the submodel, but each class receives only from the class below, through an association; the diagram shows the relationship",
     "file": "../ageintr-association/ageintr-association.json"
    }
   ],
   "current": "ageintr-association"
  }
 },
